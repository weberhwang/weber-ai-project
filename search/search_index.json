10 \u79d2</li> </ul>"},{"location":"diablo4/runes/#_19","title":"\u7d04\u59c6","text":"<ul> <li>\u9700\u8981: 500 \u9ede\u5949\u737b   (\u6ea2\u80fd: \u5ef6\u9577\u660f\u8ff7\u6301\u7e8c\u6642\u9593)</li> <li>\u51b7\u537b\u6642\u9593: 5 \u79d2</li> <li>\u5f15\u767c\u5fb7\u9b6f\u4f0a\u7684\u77f3\u5316\u6280\u80fd\uff0c\u4f7f\u6575\u4eba\u660f\u8ff7\u4e26\u6062\u5fa9\u4e3b\u8981\u8cc7\u6e90</li> </ul>"},{"location":"diablo4/runes/#_20","title":"\u7a00\u6709","text":""},{"location":"diablo4/runes/#_21","title":"\u66f8\u723e","text":"<ul> <li>\u9700\u8981: 250 \u9ede\u5949\u737b   (\u6ea2\u80fd: \u6700\u591a\u63d0\u9ad8 100% \u7bc4\u570d)</li> <li>\u51b7\u537b\u6642\u9593: 2 \u79d2</li> <li>\u5f15\u767c\u9b54\u6cd5\u4f7f\u7684\u51b0\u971c\u65b0\u661f\u6280\u80fd\uff0c\u5c0d\u6575\u4eba\u9020\u6210\u51cd\u7d50</li> </ul>"},{"location":"diablo4/runes/#_22","title":"\u9b54\u6cd5","text":""},{"location":"diablo4/runes/#_23","title":"\u666e\u5229","text":"<ul> <li>\u9700\u8981: 250 \u9ede\u5949\u737b   (\u6ea2\u80fd: \u5ef6\u9577\u9ed1\u6697\u7262\u7344\u7684\u6301\u7e8c\u6642\u9593)</li> <li>\u51b7\u537b\u6642\u9593: 3 \u79d2</li> <li>\u5f15\u767c\u8853\u58eb\u7684\u9ed1\u6697\u7262\u7344\u6280\u80fd\uff0c\u5c07\u6575\u4eba\u7e6b\u93c8\u5728\u7bc4\u570d\u5167 3 \u79d2  </li> </ul>"},{"location":"diablo4/runes/#_24","title":"\u6d85\u723e","text":"<ul> <li>\u9700\u8981: 600 \u9ede\u5949\u737b   (\u6ea2\u80fd: \u5ef6\u9577\u6301\u7e8c\u6642\u9593)</li> <li>\u51b7\u537b\u6642\u9593: 6 \u79d2</li> <li>\u5f15\u767c\u4fe0\u76dc\u7684\u96b1\u533f\u6280\u80fd\uff0c\u6301\u7e8c 5 \u79d2\uff0c\u7372\u5f97\u79fb\u52d5\u901f\u5ea6\u3001\u7121\u963b\uff0c\u4ee5\u53ca\u533f\u8e64</li> </ul>"},{"location":"diablo4/runes/#_25","title":"\u5eab\u4e9e","text":"<ul> <li>\u9700\u8981: 50 \u9ede\u5949\u737b   (\u6ea2\u80fd: \u5ef6\u9577\u6301\u7e8c\u6642\u9593)</li> <li>\u51b7\u537b\u6642\u9593: 1 \u79d2</li> <li>\u7372\u5f97 10% \u79fb\u52d5\u901f\u5ea6\uff0c\u6301\u7e8c 5 \u79d2\uff0c\u6700\u591a\u63d0\u9ad8 50%</li> </ul>"},{"location":"diablo4/runes/#_26","title":"\u7279\u4f2f","text":"<ul> <li>\u9700\u8981: 100 \u9ede\u5949\u737b   (\u6ea2\u80fd: \u6bcf\u500b\u5949\u737b\u63d0\u9ad8 1% \u50b7\u5bb3)</li> <li>\u51b7\u537b\u6642\u9593: 1 \u79d2</li> <li>\u5f15\u767c\u6b7b\u9748\u6cd5\u5e2b\u7684\u653b\u64ca\u53cd\u566c\u6280\u80fd\uff0c\u9020\u6210\u6301\u7e8c\u50b7\u5bb3\u4e26\u53cd\u64ca\u4f86\u81ea\u6575\u4eba\u7684\u50b7\u5bb3</li> </ul>"},{"location":"diablo4/runes/#_27","title":"\u932b\u514b","text":"<ul> <li>\u9700\u8981: 200 \u9ede\u5949\u737b   (\u6ea2\u80fd: \u6bcf\u500b\u5949\u737b\u63d0\u9ad8 1% \u50b7\u5bb3)</li> <li>\u51b7\u537b\u6642\u9593: 1 \u79d2</li> <li>\u5f15\u767c\u9b42\u9748\u5e2b\u7684\u9707\u76ea\u91cd\u8e0f\u6280\u80fd\uff0c\u9020\u6210\u50b7\u5bb3\u4e26\u64ca\u5012\u6575\u4eba</li> </ul>"},{"location":"mkdocs-web/","title":"MkDocs Web","text":"<p>\u9019\u500b\u5340\u57df\u7528\u4f86\u6574\u7406 MkDocs + Material for MkDocs \u7684\u5efa\u7f6e\u77e5\u8b58\u3001\u64cd\u4f5c\u6b65\u9a5f\u8207\u7dad\u8b77\u7b46\u8a18\u3002</p>"},{"location":"mkdocs-web/#_1","title":"\u7b46\u8a18","text":"<ul> <li>\u5165\u9580\u7b46\u8a18</li> </ul>"},{"location":"mkdocs-web/getting-started/","title":"MkDocs + Material \u5165\u9580\u7b46\u8a18","text":""},{"location":"mkdocs-web/getting-started/#_1","title":"\u76ee\u6a19","text":"<p>\u7528 Markdown \u5efa\u7acb\u4e00\u500b\u53ef\u4ee5\u672c\u6a5f\u9810\u89bd\u3001\u672a\u4f86\u53ef\u90e8\u7f72\u6210\u975c\u614b\u7db2\u7ad9\u7684\u77e5\u8b58\u5eab\u3002</p>"},{"location":"mkdocs-web/getting-started/#_2","title":"\u57fa\u672c\u5de5\u4f5c\u6d41","text":"<pre><code>1. \u7de8\u8f2f .md\n2. \u57f7\u884c\u672c\u6a5f\u9810\u89bd\u6307\u4ee4\n3. \u78ba\u8a8d\u7db2\u7ad9\u5167\u5bb9\n4. \u5efa\u7f6e\u975c\u614b\u7db2\u7ad9\n5. \u90e8\u7f72\u6216\u5206\u4eab\n</code></pre>"},{"location":"mkdocs-web/getting-started/#python","title":"Python \u5b89\u88dd","text":"<p>MkDocs \u662f Python \u751f\u614b\u7cfb\u7684\u5de5\u5177\uff0c\u6240\u4ee5\u5728\u5b89\u88dd MkDocs \u4e4b\u524d\uff0c\u9700\u8981\u5148\u78ba\u8a8d\u96fb\u8166\u5df2\u7d93\u6709 Python \u548c pip\u3002</p>"},{"location":"mkdocs-web/getting-started/#1-python","title":"1. \u4e0b\u8f09 Python","text":"<p>\u5230 Python \u5b98\u65b9\u7db2\u7ad9\u4e0b\u8f09 Windows \u5b89\u88dd\u7a0b\u5f0f\uff1a</p> <pre><code>https://www.python.org/downloads/windows/\n</code></pre> <p>\u5efa\u8b70\u4e0b\u8f09\u6700\u65b0\u7248\u7684 Python 3\u3002</p>"},{"location":"mkdocs-web/getting-started/#2","title":"2. \u57f7\u884c\u5b89\u88dd\u7a0b\u5f0f","text":"<p>\u6253\u958b\u4e0b\u8f09\u597d\u7684 Python \u5b89\u88dd\u7a0b\u5f0f\u5f8c\uff0c\u7b2c\u4e00\u500b\u756b\u9762\u8acb\u5148\u52fe\u9078\uff1a</p> <pre><code>Add python.exe to PATH\n</code></pre> <p>\u9019\u500b\u9078\u9805\u5f88\u91cd\u8981\u3002\u52fe\u9078\u5f8c\uff0c\u4e4b\u5f8c\u624d\u80fd\u5728 VS Code Terminal\u3001PowerShell \u6216\u547d\u4ee4\u63d0\u793a\u5b57\u5143\u4e2d\u76f4\u63a5\u4f7f\u7528\uff1a</p> <pre><code>python\npip\n</code></pre> <p>\u52fe\u9078\u5b8c\u6210\u5f8c\uff0c\u518d\u9ede\u9078\uff1a</p> <pre><code>Install Now\n</code></pre>"},{"location":"mkdocs-web/getting-started/#3-python","title":"3. \u78ba\u8a8d Python \u662f\u5426\u5b89\u88dd\u6210\u529f","text":"<p>\u5b89\u88dd\u5b8c\u6210\u5f8c\uff0c\u8acb\u91cd\u65b0\u958b\u555f VS Code Terminal\uff0c\u57f7\u884c\uff1a</p> <pre><code>python --version\npip --version\n</code></pre> <p>\u5982\u679c\u6210\u529f\uff0c\u6703\u770b\u5230 Python \u548c pip \u7684\u7248\u672c\u8cc7\u8a0a\u3002</p>"},{"location":"mkdocs-web/getting-started/#4-python","title":"4. \u5982\u679c python \u6307\u4ee4\u4e0d\u80fd\u7528","text":"<p>\u6709\u4e9b Windows \u74b0\u5883\u6703\u4f7f\u7528 <code>py</code> \u6307\u4ee4\u7ba1\u7406 Python\u3002\u53ef\u4ee5\u6539\u8a66\uff1a</p> <pre><code>py --version\npy -m pip --version\n</code></pre> <p>\u53ea\u8981\u80fd\u770b\u5230 Python \u548c pip \u7684\u7248\u672c\u865f\uff0c\u5c31\u4ee3\u8868 Python \u74b0\u5883\u53ef\u7528\u3002</p>"},{"location":"mkdocs-web/getting-started/#5-mkdocs-material","title":"5. \u5b89\u88dd MkDocs \u8207 Material","text":"<p>\u78ba\u8a8d Python \u548c pip \u90fd\u53ef\u4ee5\u4f7f\u7528\u5f8c\uff0c\u5b89\u88dd MkDocs\uff1a</p> <pre><code>pip install mkdocs mkdocs-material\n</code></pre> <p>\u5982\u679c\u4f60\u7684\u74b0\u5883\u662f\u4f7f\u7528 <code>py</code> \u6307\u4ee4\uff0c\u5247\u6539\u7528\uff1a</p> <pre><code>py -m pip install mkdocs mkdocs-material\n</code></pre>"},{"location":"mkdocs-web/getting-started/#_3","title":"\u5e38\u7528\u6307\u4ee4","text":"<p>\u672c\u6a5f\u9810\u89bd\u7db2\u7ad9\uff1a</p> <pre><code>mkdocs serve\n</code></pre> <p>\u5efa\u7f6e\u6b63\u5f0f\u975c\u614b\u7db2\u7ad9\uff1a</p> <pre><code>mkdocs build\n</code></pre>"}]}