7684\u76f4\u63a5\u62c6</li> <li>\u7a00\u6709\u624b\u5957: 3 \u5c6c\u6027\u4ee5\u4e0b\u7684\u76f4\u63a5\u62c6</li> <li>\u7a00\u6709\u8b77\u8eab\u7b26: 3 \u5c6c\u6027\u4ee5\u4e0b\u7684\u76f4\u63a5\u62c6</li> </ul>"},{"location":"diablo4/tips/#_4","title":"\u9748\u9b42\u706b\u76c6","text":"<p>\u53ef\u4ee5\u5728\u958b\u555f \u8352\u57ce \u6642\uff0c\u984d\u5916\u653e\u4e0a[\u6b66\u88dd\u8ca2\u54c1]\u589e\u52a0\u8352\u57ce\u7684\u96e3\u5ea6\u4e26\u63d0\u5347\u734e\u52f5 - \u6b66\u88dd\u8ca2\u54c1\u5efa\u8b70\u900f\u904e\u8d6b\u62c9\u8fea\u59c6\u65b9\u584a\u7684\u300c\u805a\u5408\u9ad4\u300d\u529f\u80fd\uff0c   \u5c07 5 \u500b\u6b66\u88dd\u8ca2\u54c1\u5408\u6210 1 \u500b\u5927\u578b\u6b66\u88dd\u8ca2\u54c1\uff0c   \u800c 5 \u500b\u5927\u578b\u6b66\u88dd\u8ca2\u54c1\u53c8\u80fd\u5408\u6210 1 \u500b\u79d8\u50b3\u6b66\u88dd\u8ca2\u54c1(\u7d2b\u8272)\uff0c   \u7528\u9019\u500b\u79d8\u50b3\u6b66\u88dd\u8ca2\u54c1\u900f\u904e\u706b\u76c6\u8ca2\u737b\u6253\u8352\u57ce\uff0c\u5c31\u6709\u5f88\u9ad8\u6a5f\u7387\u51fa\u73fe\u7d2b\u88dd</p>"},{"location":"diablo4/warlock-skills/","title":"\u8853\u58eb-\u6280\u80fd","text":""},{"location":"diablo4/warlock-skills/#_1","title":"\u57fa\u672c\u6280\u80fd","text":""},{"location":"diablo4/warlock-skills/#_2","title":"\u7194\u706b\u70b8\u5f48","text":"<p>\u57fa\u672c / \u7384\u5967 / \u5730\u7344\u706b</p> <ul> <li>\u7522\u751f\u61a4\u6012\uff1a10 \u9ede</li> <li>\u5e78\u904b\u89f8\u767c\u6a5f\u7387\uff1a27%</li> <li>\u5c07\u7194\u5ca9\u62cb\u5411\u6575\u4eba\uff0c\u5728\u5c0f\u7bc4\u570d\u5167\u9020\u6210 28 [75%] \u9ede\u50b7\u5bb3\u3002</li> <li>\u50b7\u5bb3\u985e\u578b\uff1a\u706b\u7130\u50b7\u5bb3</li> </ul>"},{"location":"diablo4/warlock-skills/#_3","title":"\u5f37\u5316\u5347\u7d1a(\u64c7\u4e00\u6216\u4e0d\u9078)","text":""},{"location":"diablo4/warlock-skills/#_4","title":"\u64ca\u5012","text":"<p>\u7194\u706b\u70b8\u5f48\u6709 15% \u6a5f\u7387\u64ca\u5012\u6575\u4eba 2 \u79d2\u3002 \u7576\u7194\u706b\u70b8\u5f48\u53d7\u5230[\u6613\u7206]\u5f37\u5316\u6642\uff0c\u6b64\u6a5f\u7387\u63d0\u9ad8\u81f3 100%\u3002 \u6bcf\u500b\u6575\u4eba\u6bcf 4 \u79d2\u53ea\u80fd\u89f8\u767c\u4e00\u6b21\u3002 [\u6613\u7206]:\u53d7\u5230\u6613\u7206\u5f37\u5316\u5f8c\uff0c\u64ca\u5012\u6a5f\u7387 100% \u4e14\u6b64\u6280\u80fd\u50b7\u5bb3\u589e\u52a0 50%\u3002  </p> <p>\u731c\u6e2c\u7b2c\u4e00\u767c\u5730\u7344\u706b\u6280\u80fd\u4e0d\u6703\u53d7\u5230\u6613\u7206\u5f71\u97ff\uff0c \u56e0\u70ba\u8981\u5148\u89f8\u767c\uff0c\u7136\u5f8c\u82e5\u6709\u89f8\u767c\u6613\u7206\uff0c \u5247\u7b2c\u4e8c\u767c\u7684\u64ca\u5012\u6a5f\u7387\u70ba 100% \u540c\u6642\u589e\u50b7 50%</p>"},{"location":"diablo4/warlock-skills/#_5","title":"\u7bc4\u570d\u52a0\u6210","text":"<p>\u7194\u706b\u70b8\u5f48\u7684\u5f15\u7206\u7bc4\u570d\u63d0\u9ad8 30%\uff0c\u4e14\u5c0d\u4f4d\u65bc\u4e2d\u592e\u7684\u6575\u4eba\u9020\u6210\u7684\u50b7\u5bb3\u63d0\u9ad8 30%[x]\u3002</p>"},{"location":"diablo4/warlock-skills/#_6","title":"\u6280\u80fd\u8b8a\u5316(\u64c7\u4e00\u6216\u4e0d\u9078)","text":""},{"location":"diablo4/warlock-skills/#_7","title":"\u96c6\u675f\u70b8\u5f48","text":"<p>\u7194\u706b\u70b8\u5f48\u6210\u70ba\u6df1\u6df5\u6280\u80fd\uff0c\u4e14\u73fe\u5728\u6703\u6295\u4e0b 6 \u500b\u8f03\u5c0f\u7684\u6697\u5f71\u7403\u9ad4\uff0c\u6bcf\u500b\u9020\u6210 8 [23%] \u9ede\u50b7\u5bb3\u3002 \u65bd\u653e\u53e6\u4e00\u500b\u7194\u706b\u70b8\u5f48\u6703\u8b93\u98db\u884c\u4e2d\u7684\u524d\u4e00\u6279\u70b8\u5f48\u5206\u88c2\u3002</p>"},{"location":"diablo4/warlock-skills/#_8","title":"\u60e1\u9b54\u7832\u5854","text":"<p>\u7194\u706b\u70b8\u5f48\u73fe\u5728\u4e5f\u5c6c\u65bc\u60e1\u9b54\u5b78\u8b58\u53ec\u559a\u6280\u80fd\uff0c\u5728\u5f15\u7206\u6642\u7522\u751f\u4e00\u500b\u7832\u5854\u60e1\u9b54\uff0c\u6301\u7e8c 5 \u79d2\uff0c\u5c0d\u9644\u8fd1\u6575\u4eba\u5674\u5410\u7194\u5ca9\uff0c\u6bcf\u6b21\u9020\u6210 9 [24%] \u9ede\u50b7\u5bb3\u3002\u4f60\u540c\u6642\u6700\u591a\u53ef\u4ee5\u64c1\u6709 6 \u500b\u7832\u5854\u3002</p>"},{"location":"diablo4/warlock-skills/#_9","title":"\u786b\u78fa\u8f5f\u7832","text":"<p>\u7194\u706b\u70b8\u5f48\u6703\u5728\u5f15\u7206\u5730\u9ede\u7522\u751f\u786b\u78fa\uff0c\u7206\u70b8\u6642\u9020\u6210 21 [56%] \u9ede\u50b7\u5bb3\u3002</p>"},{"location":"diablo4/warlock-skills/#_10","title":"\u984d\u5916\u6548\u679c(\u64c7\u4e00\u6216\u4e0d\u9078)","text":""},{"location":"diablo4/warlock-skills/#_11","title":"\u61a4\u6012","text":"<p>\u7194\u706b\u70b8\u5f48\u6bcf\u6b21\u5f15\u7206\u6642\u984d\u5916\u7522\u751f 1 \u9ede\u61a4\u6012\u3002</p>"},{"location":"diablo4/warlock-skills/#_12","title":"\u9060\u7a0b\u50b7\u5bb3","text":"<p>\u7194\u706b\u70b8\u5f48\u6839\u64da\u884c\u9032\u7684\u8ddd\u96e2\u4f7f\u9020\u6210\u7684\u50b7\u5bb3\u6700\u591a\u63d0\u9ad8 40%[x]\u3002</p>"},{"location":"diablo4/warlock-skills/#_13","title":"\u707d\u5384","text":"<p>\u57fa\u672c / \u7384\u5967 / \u6df1\u6df5</p> <ul> <li>\u7522\u751f\u61a4\u6012\uff1a10 \u9ede</li> <li>\u5e78\u904b\u89f8\u767c\u6a5f\u7387\uff1a20%</li> <li>\u5728\u6575\u4eba\u8eab\u4e0a\u70d9\u5370\u6a19\u8a18\uff0c\u5c0d\u5176\u65bd\u52a0[\u90aa\u5492]\u4e26\u9020\u6210 19 [50%] \u9ede\u50b7\u5bb3\u3002</li> <li>\u50b7\u5bb3\u985e\u578b\uff1a\u6697\u5f71\u50b7\u5bb3</li> </ul> <p>[\u90aa\u5492]: \u6703\u4f7f\u6575\u4eba\u53d7\u5230\u7684\u6df1\u6df5\u6280\u80fd\u50b7\u5bb3\u4f9d\u5176\u5931\u53bb\u751f\u547d\u503c\u63d0\u9ad8\u6700\u591a 15%[+]\u3002\u6700\u591a\u5806\u758a 3 \u6b21\u3002</p> <ul> <li>\u602a\u7269\u8eab\u4e0a\u770b\u4e0d\u51fa\u5e7e\u5c64\u662f\u6b63\u5e38\u7684\uff0c\u76ee\u524d\u6c92\u6709\u660e\u78ba\u7684\u5c64\u6578\u6578\u5b57\u6216\u5c64\u6578\u5716\u793a\u53ef\u5224\u65b7\u3002</li> <li>\u5be6\u6230\u5224\u65b7\u65b9\u5f0f\u53ea\u80fd\u7528\u624b\u52d5\u8a18\u65bd\u653e\u6b21\u6578\uff0c\u6216\u7528\u300c\u6ec5\u7130\u5100\u5f0f\u300d\u78ba\u8a8d\u6eff\u5c64\u72c0\u614b\uff1b\u56e0\u70ba\u6ec5\u7130\u5100\u5f0f\u660e\u5beb\u90aa\u5492\u6703\u4ee5\u5806\u758a\u4e0a\u9650\u65bd\u52a0\u3002</li> </ul>"},{"location":"diablo4/warlock-skills/#_14","title":"\u5f37\u5316\u5347\u7d1a(\u64c7\u4e00\u6216\u4e0d\u9078)","text":""},{"location":"diablo4/warlock-skills/#_15","title":"\u50b7\u5bb3","text":"<p>\u6575\u4eba\u6bcf\u53d7\u5230\u90aa\u5492\u5f71\u97ff\u4e00\u79d2\uff0c\u4f7f\u707d\u5384\u5c0d\u5176\u9020\u6210\u7684\u50b7\u5bb3\u63d0\u9ad8 1%[x]\u3002</p>"},{"location":"diablo4/warlock-skills/#_16","title":"\u61a4\u6012","text":"<p>\u6bcf\u500b\u53d7\u5230\u90aa\u5492\u5f71\u97ff\u7684\u6575\u4eba\uff0c\u4f7f\u707d\u5384\u6bcf 2 \u79d2\u7522\u751f 1 \u9ede\u61a4\u6012\u3002</p> <p>\u5982\u679c\u90aa\u5492\u53ef\u4ee5\u7a69\u5b9a\u639b\u5728\u591a\u500b\u6575\u4eba\u8eab\u4e0a\uff0c \u9019\u500b\u5206\u652f\u6703\u8b93\u707d\u5384\u8b8a\u6210\u504f\u8cc7\u6e90\u5faa\u74b0\u7684\u6280\u80fd\u3002</p>"},{"location":"diablo4/warlock-skills/#_17","title":"\u6280\u80fd\u8b8a\u5316(\u64c7\u4e00\u6216\u4e0d\u9078)","text":""},{"location":"diablo4/warlock-skills/#_18","title":"\u540c\u5316","text":"<p>\u5c0d[\u6613\u50b7]\u3001[\u524a\u5f31]\u6216\u7de9\u901f\u7684\u6575\u4eba\u65bd\u653e\u707d\u5384\u6703\u5c07\u6548\u679c\u540c\u5316\uff0c\u4f7f\u707d\u5384\u4e5f\u65bd\u52a0\u540c\u6a23\u7684\u6548\u679c\uff0c\u6301\u7e8c 3 \u79d2\u3002</p> <p>[\u6613\u50b7]: \u6575\u4eba\u53d7\u5230\u7684\u50b7\u5bb3\u63d0\u9ad8 20%\u3002 [\u524a\u5f31]: \u6575\u4eba\u9020\u6210\u7684\u50b7\u5bb3\u6703\u964d\u4f4e\uff0c\u666e\u901a\u6575\u4eba\u6e1b\u5c11 20%\uff0c\u7cbe\u82f1\u602a\u7269\u6e1b\u5c11 15%\uff0c\u9996\u9818\u6e1b\u5c11 10%\u3002</p> <p>\u540c\u5316\u7684\u610f\u601d\u300c\u4f60\u65bd\u653e\u707d\u5384\u6642\uff0c\u76ee\u6a19\u8eab\u4e0a\u5982\u679c\u5df2\u7d93\u6709\u6613\u50b7\u3001\u524a\u5f31\u6216\u7de9\u901f\uff0c\u707d\u5384\u6703\u628a\u90a3\u4e9b\u72c0\u614b\u8907\u88fd\u6210\u707d\u5384\u81ea\u5df1\u7684\u9644\u52a0\u6548\u679c\uff0c\u6301\u7e8c 3 \u79d2\u300d\u3002 \u540c\u5316\u4e0d\u662f\u81ea\u5df1\u6191\u7a7a\u7522\u751f\u6613\u50b7\u3001\u524a\u5f31\u3001\u7de9\u901f\uff0c \u800c\u662f\u9700\u8981\u5148\u6709\u4e00\u500b\u4f86\u6e90\u628a\u72c0\u614b\u639b\u4e0a\u53bb\uff0c\u518d\u7531\u707d\u5384\u63a5\u624b\u5ef6\u4f38\u3002</p> <p>\u4f8b\u5b50\uff1a</p> <ul> <li>\u5c0d\u5df2\u7d93\u6613\u50b7\u7684\u6575\u4eba\u653e\u707d\u5384\uff0c\u707d\u5384\u6703\u9644\u5e36\u6613\u50b7 3 \u79d2\u3002</li> <li>\u5c0d\u5df2\u7d93\u524a\u5f31\u7684\u6575\u4eba\u653e\u707d\u5384\uff0c\u707d\u5384\u6703\u9644\u5e36\u524a\u5f31 3 \u79d2\u3002</li> <li>\u5c0d\u5df2\u7d93\u7de9\u901f\u7684\u6575\u4eba\u653e\u707d\u5384\uff0c\u707d\u5384\u6703\u9644\u5e36\u7de9\u901f 3 \u79d2\u3002</li> </ul>"},{"location":"diablo4/warlock-skills/#_19","title":"\u8ff4\u97ff","text":"<p>\u65bd\u653e\u707d\u5384\u6703\u5c07\u5176 10% \u50b7\u5bb3[\u8ff4\u97ff]\u81f3\u9644\u8fd1\u6240\u6709\u53d7\u90aa\u5492\u5f71\u97ff\u7684\u6575\u4eba\u8eab\u4e0a\u3002</p> <p>[\u8ff4\u97ff]:\u707d\u5384\u547d\u4e2d\u6642\uff0c\u6703\u628a\u9019\u6b21\u707d\u5384\u50b7\u5bb3\u7684 10%\uff0c\u984d\u5916\u6253\u5230\u9644\u8fd1\u6240\u6709\u5df2\u53d7\u90aa\u5492\u5f71\u97ff\u7684\u6575\u4eba\u8eab\u4e0a\u3002</p> <ul> <li>\u8ff4\u97ff\u5403\u7684\u662f\u707d\u5384\u672c\u6b21\u50b7\u5bb3\uff0c\u4e0d\u662f\u6df1\u6df5\u6280\u80fd\u7e3d\u50b7\u5bb3\u3002</li> <li>\u9700\u8981\u9644\u8fd1\u6575\u4eba\u5df2\u7d93\u6709\u90aa\u5492\uff0c\u624d\u6703\u5403\u5230\u9019\u6bb5\u984d\u5916\u50b7\u5bb3\u3002</li> <li>\u9019\u6bd4\u8f03\u50cf\u64f4\u6563/\u9023\u9396\u50b7\u5bb3\uff0c\u4e0d\u50cf\u6301\u7e8c\u50b7\u5bb3\u3002</li> </ul> <p>\u5982\u679c\u53ea\u6709\u6253\u4e00\u96bb\u738b\uff0c\u8ff4\u97ff\u50f9\u503c\u53ef\u80fd\u504f\u4f4e\u3002  </p>"},{"location":"diablo4/warlock-skills/#_20","title":"\u984d\u5916\u6548\u679c(\u64c7\u4e00\u6216\u4e0d\u9078)","text":""},{"location":"diablo4/warlock-skills/#_21","title":"\u6b7b\u4ea1\u8513\u5ef6","text":"<p>\u7576\u4f60\u64ca\u6bba\u88ab\u90aa\u5492\u5f71\u97ff\u7684\u6575\u4eba\u6642\uff0c\u707d\u5384\u6703\u5c07\u90aa\u5492\u64f4\u6563\u81f3\u53e6\u4e00\u500b\u6575\u4eba\u8eab\u4e0a\uff0c\u4e26\u5c0d\u5176\u9020\u6210 19 [50%] \u9ede\u50b7\u5bb3\u3002</p> <p>\u6bd4\u8f03\u9069\u5408\u6e05\u602a\uff0c\u53ea\u8981\u64ca\u6bba\u7bc0\u594f\u9806\uff0c\u90aa\u5492\u53ef\u4ee5\u4e0d\u7528\u4e00\u76f4\u624b\u52d5\u88dc\u5728\u65b0\u76ee\u6a19\u4e0a\u3002</p>"},{"location":"diablo4/warlock-skills/#_22","title":"\u7344\u5352","text":"<p>\u707d\u5384\u8b8a\u70ba\u9060\u8ddd\u671d\u5730\u9762\u65bd\u653e\uff0c\u4e26\u7559\u4e0b\u4e00\u500b\u6a19\u8a18\uff0c\u6703\u7e6b\u93c8\u4f60\u7684\u4e3b\u8981\u76ee\u6a19\u4e26\u5c0d\u7bc4\u570d\u5167\u7684\u6575\u4eba\u65bd\u52a0\u90aa\u5492\uff0c\u6301\u7e8c 6 \u79d2\u3002</p> <p>\u76ee\u524d\u7121\u6cd5\u4e86\u89e3\u300c\u7e6b\u93c8\u4f60\u7684\u4e3b\u8981\u76ee\u6a19\u4e26\u5c0d\u7bc4\u570d\u5167\u7684\u6575\u4eba\u65bd\u52a0\u90aa\u5492\uff0c\u6301\u7e8c 6 \u79d2\u300d\u5be6\u969b\u7684\u529f\u6548\uff0c \u6bd4\u5982 6 \u79d2\u5167\u6703\u758a\u5230\u5e7e\u5c64\uff1f\u7e6b\u93c8\u7684\u6548\u679c\u53c8\u662f\u4ec0\u9ebc\uff1f</p>"},{"location":"diablo4/warlock-skills/#_23","title":"\u6ec5\u7130\u5100\u5f0f","text":"<p>\u707d\u5384\u6210\u70ba\u5730\u7344\u706b\u6280\u80fd\uff0c\u4f60\u7684\u90aa\u5492\u6703\u4ee5\u5806\u758a\u4e0a\u9650\u65bd\u52a0\uff0c\u6301\u7e8c 15 \u79d2\uff0c\u4f46\u4f60\u6700\u591a\u53ea\u80fd\u5c0d\u4e00\u500b\u76ee\u6a19\u65bd\u52a0\u90aa\u5492\u3002 \u7576\u90aa\u5492\u6548\u679c\u7d50\u675f\u6216\u88ab\u79fb\u9664\u6642\uff0c\u707d\u5384\u6703\u9020\u6210 67 [175%] \u9ede\u50b7\u5bb3\uff0c\u7531\u7bc4\u570d\u5167\u7684\u6240\u6709\u6575\u4eba\u5e73\u5747\u5206\u6524\u3002</p> <p>\u55ae\u9ad4\u6216\u9996\u9818\u53d6\u5411\u7684\u5206\u652f\u3002 \u4ee3\u50f9\u662f\u53ea\u80fd\u8a5b\u5492\u4e00\u500b\u76ee\u6a19\uff0c\u4f46\u53ef\u4ee5\u76f4\u63a5\u6eff\u5c64\u4e26\u62c9\u9577\u6301\u7e8c\u6642\u9593\uff0c\u6700\u5f8c\u518d\u88dc\u4e00\u6bb5\u5ef6\u9072\u7206\u767c\u3002</p> <p>\u6642\u9593\u7d50\u675f\u6642\uff0c\u76ee\u6a19\u672c\u8eab\u4e5f\u6703\u53d7\u50b7\u5bb3\uff0c\u4f46\u6b64\u50b7\u5bb3\u662f\u7531\u7bc4\u570d\u5167\u6240\u6709\u6575\u4eba\u5e73\u5747\u5206\u6524\u3002</p> <p>\u4f8b\u5b50\uff1a</p> <ul> <li>\u7d50\u675f\u6642\u7bc4\u570d\u5167\u53ea\u6709\u88ab\u90aa\u5492\u7684\u76ee\u6a19 1 \u96bb\uff1a\u8a72\u76ee\u6a19\u5403\u5b8c\u6574 67 [175%]\u3002</li> <li>\u7d50\u675f\u6642\u7bc4\u570d\u5167\u6709 2 \u96bb\u6575\u4eba\uff1a\u6bcf\u96bb\u7d04\u5403\u4e00\u534a\uff0c\u4e5f\u5c31\u662f\u7e3d\u50b7\u5bb3\u5e73\u5747\u5206\u6524\u3002</li> <li>\u7d50\u675f\u6642\u7bc4\u570d\u5167\u6709 5 \u96bb\u6575\u4eba\uff1a\u6bcf\u96bb\u7d04\u5403\u4e94\u5206\u4e4b\u4e00\u3002</li> </ul>"},{"location":"diablo4/warlock-skills/#_24","title":"\u6838\u5fc3\u6280\u80fd","text":""},{"location":"diablo4/warlock-skills/#_25","title":"\u9632\u79a6\u6280\u80fd","text":""},{"location":"diablo4/warlock-skills/#_26","title":"\u5927\u60e1\u9b54\u6280\u80fd","text":""},{"location":"diablo4/warlock-skills/#_27","title":"\u5fbd\u8a18\u6280\u80fd","text":""},{"location":"diablo4/warlock-skills/#_28","title":"\u7d55\u62db\u6280\u80fd","text":""},{"location":"mkdocs-web/","title":"MkDocs Web","text":"<p>\u9019\u500b\u5340\u57df\u7528\u4f86\u6574\u7406 MkDocs + Material for MkDocs \u7684\u5efa\u7f6e\u77e5\u8b58\u3001\u64cd\u4f5c\u6b65\u9a5f\u8207\u7dad\u8b77\u7b46\u8a18\u3002</p>"},{"location":"mkdocs-web/#_1","title":"\u7b46\u8a18","text":"<ul> <li>\u5165\u9580\u7b46\u8a18</li> </ul>"},{"location":"mkdocs-web/getting-started/","title":"MkDocs + Material \u5165\u9580\u7b46\u8a18","text":""},{"location":"mkdocs-web/getting-started/#_1","title":"\u76ee\u6a19","text":"<p>\u7528 Markdown \u5efa\u7acb\u4e00\u500b\u53ef\u4ee5\u672c\u6a5f\u9810\u89bd\u3001\u672a\u4f86\u53ef\u90e8\u7f72\u6210\u975c\u614b\u7db2\u7ad9\u7684\u77e5\u8b58\u5eab\u3002</p>"},{"location":"mkdocs-web/getting-started/#_2","title":"\u57fa\u672c\u5de5\u4f5c\u6d41","text":"<pre><code>1. \u7de8\u8f2f .md\n2. \u57f7\u884c\u672c\u6a5f\u9810\u89bd\u6307\u4ee4\n3. \u78ba\u8a8d\u7db2\u7ad9\u5167\u5bb9\n4. \u5efa\u7f6e\u975c\u614b\u7db2\u7ad9\n5. \u90e8\u7f72\u6216\u5206\u4eab\n</code></pre>"},{"location":"mkdocs-web/getting-started/#python","title":"Python \u5b89\u88dd","text":"<p>MkDocs \u662f Python \u751f\u614b\u7cfb\u7684\u5de5\u5177\uff0c\u6240\u4ee5\u5728\u5b89\u88dd MkDocs \u4e4b\u524d\uff0c\u9700\u8981\u5148\u78ba\u8a8d\u96fb\u8166\u5df2\u7d93\u6709 Python \u548c pip\u3002</p>"},{"location":"mkdocs-web/getting-started/#1-python","title":"1. \u4e0b\u8f09 Python","text":"<p>\u5230 Python \u5b98\u65b9\u7db2\u7ad9\u4e0b\u8f09 Windows \u5b89\u88dd\u7a0b\u5f0f\uff1a</p> <pre><code>https://www.python.org/downloads/windows/\n</code></pre> <p>\u5efa\u8b70\u4e0b\u8f09\u6700\u65b0\u7248\u7684 Python 3\u3002</p>"},{"location":"mkdocs-web/getting-started/#2","title":"2. \u57f7\u884c\u5b89\u88dd\u7a0b\u5f0f","text":"<p>\u6253\u958b\u4e0b\u8f09\u597d\u7684 Python \u5b89\u88dd\u7a0b\u5f0f\u5f8c\uff0c\u7b2c\u4e00\u500b\u756b\u9762\u8acb\u5148\u52fe\u9078\uff1a</p> <pre><code>Add python.exe to PATH\n</code></pre> <p>\u9019\u500b\u9078\u9805\u5f88\u91cd\u8981\u3002\u52fe\u9078\u5f8c\uff0c\u4e4b\u5f8c\u624d\u80fd\u5728 VS Code Terminal\u3001PowerShell \u6216\u547d\u4ee4\u63d0\u793a\u5b57\u5143\u4e2d\u76f4\u63a5\u4f7f\u7528\uff1a</p> <pre><code>python\npip\n</code></pre> <p>\u52fe\u9078\u5b8c\u6210\u5f8c\uff0c\u518d\u9ede\u9078\uff1a</p> <pre><code>Install Now\n</code></pre>"},{"location":"mkdocs-web/getting-started/#3-python","title":"3. \u78ba\u8a8d Python \u662f\u5426\u5b89\u88dd\u6210\u529f","text":"<p>\u5b89\u88dd\u5b8c\u6210\u5f8c\uff0c\u8acb\u91cd\u65b0\u958b\u555f VS Code Terminal\uff0c\u57f7\u884c\uff1a</p> <pre><code>python --version\npip --version\n</code></pre> <p>\u5982\u679c\u6210\u529f\uff0c\u6703\u770b\u5230 Python \u548c pip \u7684\u7248\u672c\u8cc7\u8a0a\u3002</p>"},{"location":"mkdocs-web/getting-started/#4-python","title":"4. \u5982\u679c python \u6307\u4ee4\u4e0d\u80fd\u7528","text":"<p>\u6709\u4e9b Windows \u74b0\u5883\u6703\u4f7f\u7528 <code>py</code> \u6307\u4ee4\u7ba1\u7406 Python\u3002\u53ef\u4ee5\u6539\u8a66\uff1a</p> <pre><code>py --version\npy -m pip --version\n</code></pre> <p>\u53ea\u8981\u80fd\u770b\u5230 Python \u548c pip \u7684\u7248\u672c\u865f\uff0c\u5c31\u4ee3\u8868 Python \u74b0\u5883\u53ef\u7528\u3002</p>"},{"location":"mkdocs-web/getting-started/#5-mkdocs-material","title":"5. \u5b89\u88dd MkDocs \u8207 Material","text":"<p>\u78ba\u8a8d Python \u548c pip \u90fd\u53ef\u4ee5\u4f7f\u7528\u5f8c\uff0c\u5b89\u88dd MkDocs\uff1a</p> <pre><code>pip install mkdocs mkdocs-material\n</code></pre> <p>\u5982\u679c\u4f60\u7684\u74b0\u5883\u662f\u4f7f\u7528 <code>py</code> \u6307\u4ee4\uff0c\u5247\u6539\u7528\uff1a</p> <pre><code>py -m pip install mkdocs mkdocs-material\n</code></pre>"},{"location":"mkdocs-web/getting-started/#_3","title":"\u5e38\u7528\u6307\u4ee4","text":"<p>\u672c\u6a5f\u9810\u89bd\u7db2\u7ad9\uff1a</p> <pre><code>mkdocs serve\n</code></pre> <p>\u5efa\u7f6e\u6b63\u5f0f\u975c\u614b\u7db2\u7ad9\uff1a</p> <pre><code>mkdocs build\n</code></pre>"},{"location":"mkdocs-web/getting-started/#github","title":"\u90e8\u7f72\u7db2\u7ad9\u5230 GitHub","text":"<p><pre><code>git add .\ngit commit -m \"Update docs\"\ngit push\nmkdocs gh-deploy\n</code></pre> https://weberhwang.github.io/weber-ai-project/</p>"}]}